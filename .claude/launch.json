{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "truearch-http",
      "runtimeExecutable": "./venv/bin/python",
      "runtimeArgs": ["-m", "src.mcp.server", "--http"],
      "port": 8001,
      "env": {
        "PORT": "8001",
        "HOST": "127.0.0.1"
      }
    },
    {
      "name": "truearch-api",
      "runtimeExecutable": "./venv/bin/python",
      "runtimeArgs": ["-m", "uvicorn", "src.api.main:app", "--reload", "--port", "8000"],
      "port": 8000
    }
  ]
}
