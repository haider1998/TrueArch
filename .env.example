# TrueArch Environment Variables
# Copy to .env for local development. Never commit .env.

# ── Data ─────────────────────────────────────────────────────────────────────
# Path to the curated framework YAML directory
TRUEARCH_DATA_DIR=data/frameworks

# ── Server ───────────────────────────────────────────────────────────────────
# Port for the streamable-HTTP MCP server (--http mode)
PORT=8001

# ── Auth (Phase 2 — uncomment when adding API key middleware) ─────────────────
# Comma-separated list of valid bearer tokens
# TRUEARCH_API_KEYS=key_abc123,key_def456

# ── Environment ───────────────────────────────────────────────────────────────
TRUEARCH_ENV=production   # development | production
